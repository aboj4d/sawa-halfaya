# Copy to backend/.env and fill in real values. Never commit .env.

# --- required (server exits without them, unless NODE_ENV=development) ---
JWT_SECRET=
ADMIN_PASSWORD=

# --- environment ---
# development = random secrets allowed, registration works without SMTP
# anything else (or unset) = production behaviour
NODE_ENV=production

# --- public URLs (CORS + verification links) ---
APP_URL=http://localhost:3000
# FRONTEND_URL=

# --- behind a reverse proxy (Render, nginx...) ---
# TRUST_PROXY=1

# --- SMTP (required for registration in production) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=

# --- optional ---
# PORT=3000
# SSL_KEY_PATH=./certs/localhost.key
# SSL_CERT_PATH=./certs/localhost.crt
